@using Microsoft.AspNetCore.Html
@using Amazon.SimpleSystemsManagement
@using Amazon.SimpleSystemsManagement.Model


<!DOCTYPE html>
<html lang="en">
<head>
    @(new HtmlString(new AmazonSimpleSystemsManagementClient().GetParameterAsync(new GetParameterRequest() { Name = "/petstore/rumscript" }).Result.Parameter.Value))
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Resilient Pet Adoptions</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/petstyles.css" asp-append-version="true"/>
</head>
<body>
<div class="pet-wrapper">
    <header class="pet-header">

        <div class="container">
            <nav class="pet-nav">
                <a asp-controller="home" asp-action="index" class="pet-brand" aria-label="Resilient Pet Adoptions home">
                    <i class="bi bi-heart-pulse pet-brand-icon" aria-hidden="true"></i>
                    <span class="pet-brand-text">Resilient<span class="pet-brand-accent"> Pet Adoptions</span></span>
                </a>
                <div class="pet-nav-links">
                    <a asp-controller="PetListAdoptions" asp-action="index" id="seeadoptionlist" class="pet-nav-link">
                        <i class="bi bi-list-check" aria-hidden="true"></i> See Adoption List
                    </a>
                    <a asp-controller="Home" asp-action="HouseKeeping" id="performhousekeeping" class="pet-nav-link">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Perform Housekeeping
                    </a>
                </div>
            </nav>
        </div>
    </header>
    @RenderBody()

    <footer class="pet-runtime-footer">
        <partial name="_RuntimeBadge" />
    </footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>