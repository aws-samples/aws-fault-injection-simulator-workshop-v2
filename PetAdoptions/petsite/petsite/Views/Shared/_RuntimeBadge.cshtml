@using PetSite
@using System.Diagnostics
@*
    "Served by" footer bar. Shows which service / Availability Zone / node /
    instance rendered this page and how long it took, as a row of labeled chips.
    During FIS experiments (AZ power interruption, instance termination, injected
    latency) participants can watch the node/instance change or the latency chip
    turn amber/red in the page itself, instead of leaving for CloudWatch.

    Values come from RuntimeContext (env + ECS task metadata) and the per-request
    stopwatch stashed in HttpContext.Items by the request middleware. On EKS the
    AZ is not exposed to the pod (node IMDS hop limit), so when AZ is unknown we
    simply omit the AZ chip and lead with the node — which maps 1:1 to an AZ.
*@
@{
    var sw = Context.Items["RequestStopwatch"] as Stopwatch;
    long latencyMs = sw?.ElapsedMilliseconds ?? -1;
    // Latency thresholds for the health dot (ms). Normal PetSite renders are
    // tens of ms; injected network latency pushes this well past 250ms.
    string state = latencyMs < 0 ? "unknown" : latencyMs < 250 ? "ok" : latencyMs < 750 ? "warn" : "crit";

    var service = string.IsNullOrEmpty(RuntimeContext.Service) ? "petsite" : RuntimeContext.Service;
    var az = RuntimeContext.AvailabilityZone;
    var node = RuntimeContext.Node;
    var instance = RuntimeContext.Instance;
    var latencyText = latencyMs < 0 ? "–" : $"{latencyMs} ms";
}

<div class="pet-runtime pet-runtime-@state" role="status" aria-live="polite">
    <span class="pet-runtime-lead">
        <i class="bi bi-hdd-network" aria-hidden="true"></i> Served&nbsp;by
    </span>

    <span class="pet-runtime-chip" title="Service rendering this page">
        <span class="pet-runtime-label">service</span>
        <span class="pet-runtime-val">@service</span>
    </span>

    @if (!string.IsNullOrEmpty(az))
    {
        <span class="pet-runtime-chip" title="Availability Zone">
            <i class="bi bi-geo-alt pet-runtime-ico" aria-hidden="true"></i>
            <span class="pet-runtime-label">AZ</span>
            <span class="pet-runtime-val">@az</span>
        </span>
    }

    @if (!string.IsNullOrEmpty(node))
    {
        <span class="pet-runtime-chip" title="EC2 node that served this request (maps to an Availability Zone)">
            <i class="bi bi-hdd-rack pet-runtime-ico" aria-hidden="true"></i>
            <span class="pet-runtime-label">node</span>
            <span class="pet-runtime-val">@node</span>
        </span>
    }

    @if (!string.IsNullOrEmpty(instance))
    {
        <span class="pet-runtime-chip pet-runtime-chip-muted" title="Pod / instance that served this request">
            <i class="bi bi-box pet-runtime-ico" aria-hidden="true"></i>
            <span class="pet-runtime-label">instance</span>
            <span class="pet-runtime-val">@instance</span>
        </span>
    }

    <span class="pet-runtime-chip pet-runtime-latency-chip" title="Server-side render time for this request — watch it rise during a latency experiment">
        <span class="pet-runtime-dot" aria-hidden="true"></span>
        <span class="pet-runtime-val">@latencyText</span>
    </span>
</div>
