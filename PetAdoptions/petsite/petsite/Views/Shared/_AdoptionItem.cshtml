@model Pet;

    <div class="pet-card h-100">
        <img class="pet-thumbnail" src="@Model.peturl" alt="@Model.pettype @Model.petcolor, adopted" />

        <div class="pet-name">
            <span>@Model.pettype-@Model.petcolor</span>
        </div>
        <div class="pet-price">
            <span>@Model.price</span>
        </div>
        <div class="pet-list-item">
            <span>Adoption Id-@Model.transactionid</span>
        </div>
        <div class="pet-list-item">
            <span>Adopted on-@Model.adoptiondate</span>
        </div>
    </div>