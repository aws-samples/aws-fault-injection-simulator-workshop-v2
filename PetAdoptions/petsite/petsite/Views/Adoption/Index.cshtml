@using PetSite.ViewModels
@{
    ViewData["Title"] = "Adopt Me";
    @model Pet;
}

@* Bootstrap 5 + Bootstrap Icons are loaded globally by _Layout. The previous
   version of this page pulled a SECOND Bootstrap (5.1.3) and jQuery from a CDN
   on top of the layout's framework and then used Bootstrap 3 markup
   (panel / glyphicon / input-group-addon), which rendered broken. *@

<section class="pet-hero">
    <div class="container">
        <img class="pet-hero-title" src="~/images/main_banner_text.png" alt="PetAdoptions" />
    </div>
</section>

<div class="container my-4">
    <div class="row align-items-center g-4">
        <div class="col-md-6 text-center">
            <img class="pet-thumbnail img-fluid rounded-3 shadow-sm" src="@Model.peturl" alt="@Model.pettype @Model.petcolor for adoption" />
            <div class="pet-name mt-2">
                <span>@Model.pettype-@Model.petcolor</span>
            </div>
            <div class="pet-price">
                <span>@Model.price</span>
            </div>
            <div class="pet-rating" role="img" aria-label="Cuteness rating @Model.cuteness_rate out of 5">
                @for (int i = 0; i < 5; i++)
                {
                    var filled = i < Int32.Parse(Model.cuteness_rate);
                    <i class="bi @(filled ? "bi-star-fill" : "bi-star") pet-star" aria-hidden="true"></i>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="h5 mb-0">Payment Details</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning py-2" role="alert">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        Information entered on this page is neither stored nor processed.
                    </div>
                    <form role="form">
                        <div class="mb-3">
                            <label class="form-label" for="cardNumber">CARD NUMBER</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="cardNumber" placeholder="Valid Card Number" value="0001 1000 0001 1000" required autofocus />
                                <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-7">
                                <label class="form-label" for="expityMonth">EXPIRY DATE</label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="text" class="form-control" id="expityMonth" placeholder="MM" required value="12" />
                                    </div>
                                    <div class="col-6">
                                        <input type="text" class="form-control" id="expityYear" placeholder="YY" required value="2025" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-5">
                                <label class="form-label" for="cvCode">CV CODE</label>
                                <input type="password" class="form-control" id="cvCode" placeholder="CV" value="987" required />
                            </div>
                        </div>
                    </form>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="fw-semibold">Final Payment</span>
                        <span class="badge bg-success fs-6">@Model.price</span>
                    </div>

                    <form asp-controller="Payment" asp-action="MakePayment" method="post" class="mt-3">
                        <input class="btn btn-success btn-lg w-100" type="submit" value="Pay" />
                        <input type="hidden" asp-for="@Model.petid" name="petid" />
                        <input type="hidden" asp-for="@Model.pettype" name="pettype" />
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Hidden fields preserved from the original page (carry the pet selection). *@
    <input type="hidden" asp-for="@Model.petcolor" name="petcolor" />
    <input type="hidden" asp-for="@Model.peturl" name="peturl" />
    <input type="hidden" asp-for="@Model.cuteness_rate" name="cuteness_rate" />
</div>
