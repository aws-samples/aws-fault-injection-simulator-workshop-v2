@using PetSite.ViewModels;

@{
    ViewData["Title"] = "Home Page";
    @model PetDetails;
}

<section class="pet-hero">
    <div class="container">
        <partial name="_Hero" />
    </div>
</section>

<section class="pet-filters">
    <div class="container">
        <form method="get">
            <label class="pet-label" data-title="Type">
                <select name="selectedPetType" asp-for="@Model.Varieties.SelectedPetType" asp-items="@Model.Varieties.PetTypes" class="pet-filter" aria-label="Pet type"></select>
            </label>
            <label class="pet-label" data-title="Color">
                <select name="selectedPetColor" asp-for="@Model.Varieties.SelectedPetColor" asp-items="@Model.Varieties.PetColors" class="pet-filter" aria-label="Pet color"></select>
            </label>
            <label class="pet-label" data-title="Show">
                <select name="pageSize" asp-for="@Model.Varieties.SelectedPageSize" asp-items="@Model.Varieties.PageSizes" class="pet-filter" aria-label="Number of pets to show" onchange="this.form.submit()"></select>
            </label>
            <input id="searchpets" type="submit" value="Search" class="rounded-lg"/>

        </form>
    </div>
</section>


<div class="container">
    @if (ViewData["SearchDegraded"] as bool? == true)
    {
        @* Graceful degradation: when the Search service can't be reached (e.g.
           during an FIS network-latency / AZ-slowdown experiment) we show this
           card instead of a raw 500, and surface which AZ served the failed
           request so the blast radius is visible in the app itself. *@
        <div class="alert alert-warning d-flex align-items-center my-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3" aria-hidden="true"></i>
            <div>
                <h4 class="alert-heading h5 mb-1">Search is degraded right now</h4>
                <p class="mb-2">
                    Pets couldn&#39;t be loaded
                    @if (!string.IsNullOrEmpty(PetSite.RuntimeContext.AvailabilityZone))
                    {
                        <text>from Availability Zone <strong>@PetSite.RuntimeContext.AvailabilityZone</strong></text>
                    }
                    . The rest of the site is still available — this is a gray failure.
                </p>
                <a class="btn btn-sm btn-outline-dark" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry
                </a>
            </div>
        </div>
    }
    else if (Model.Pets.Any())
    {
        <div class="pet-grid">
            @foreach (var pet in Model.Pets)
            {
                <div class="pet-item">
                    <partial name="_PetItem" for="@pet" />
                </div>
            }
        </div>

        var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
        var totalPages = (int)(ViewData["TotalPages"] ?? 1);
        var totalPets = (int)(ViewData["TotalPets"] ?? 0);
        if (totalPages > 1)
        {
            <nav class="pet-pagination" aria-label="Pet list pages">
                <a class="pet-page-btn @(currentPage <= 1 ? "is-disabled" : "")"
                   asp-action="Index"
                   asp-route-selectedPetType="@Model.Varieties.SelectedPetType"
                   asp-route-selectedPetColor="@Model.Varieties.SelectedPetColor"
                   asp-route-pageSize="@Model.Varieties.SelectedPageSize"
                   asp-route-page="@(currentPage - 1)"
                   aria-disabled="@(currentPage <= 1 ? "true" : "false")">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                </a>
                <span class="pet-page-status">Page @currentPage of @totalPages &middot; @totalPets pets</span>
                <a class="pet-page-btn @(currentPage >= totalPages ? "is-disabled" : "")"
                   asp-action="Index"
                   asp-route-selectedPetType="@Model.Varieties.SelectedPetType"
                   asp-route-selectedPetColor="@Model.Varieties.SelectedPetColor"
                   asp-route-pageSize="@Model.Varieties.SelectedPageSize"
                   asp-route-page="@(currentPage + 1)"
                   aria-disabled="@(currentPage >= totalPages ? "true" : "false")">
                    Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
    }
    else
    {
        <div class="pet-items my-4">
            <p class="text-muted">NO PETS AVAILABLE WITH THAT SEARCH CONDITION</p>
        </div>
    }
</div>