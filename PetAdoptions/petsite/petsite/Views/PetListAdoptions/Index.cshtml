@model List<Pet>

@{
    ViewData["Title"] = "Pet Adoption List";
}

<section class="pet-hero">
    <div class="container">
        <partial name="_Hero" />
    </div>
</section>


<div class="container">
    @if (Model.Any())
    {
        <div class="pet-grid">
            @foreach (var pet in Model)
            {
                <div class="pet-item">
                    <partial name="_AdoptionItem" for="@pet" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="pet-items my-4">
            <p class="text-muted">No adoption data retrieved</p>
        </div>
    }
</div>
