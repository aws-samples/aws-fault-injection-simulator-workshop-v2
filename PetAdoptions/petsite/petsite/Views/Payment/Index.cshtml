<section class="pet-hero">
    <div class="container">
        <img class="pet-hero-title" src="~/images/main_banner_text.png" alt="PetAdoptions" />
    </div>
</section>

<div class="container my-4">
    @if (ViewData["txStatus"].ToString() == "success")
    {
    <div class="alert alert-success" role="alert">
      <h4 class="alert-heading"><i class="bi bi-check-circle" aria-hidden="true"></i> Adoption Complete</h4>
      <hr>
      <p class="mb-0">Thank you for adopting me!</p>
    </div>
    }
    else
    {
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Error</h4>
      <hr>
      <p class="mb-0">Sorry, something went wrong</p>
    </div>
    <p>Error @ViewData["error"]</p>
    }
</div>